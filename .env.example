PORT=3000
ADMIN_USERNAME=owner
ADMIN_PASSWORD=replace-with-a-unique-strong-password
SESSION_SECRET=generate-a-random-secret-at-least-32-characters-long
# Set to true when the app is served over HTTPS.
COOKIE_SECURE=false
# For Vercel/Neon, enter DATABASE_URL as a private environment variable in the Vercel dashboard.
# Do not add your real connection string to this file or commit it.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Leave DATABASE_URL unset to use local SQLite.
# Optional absolute or relative path to the local SQLite database.
# DATABASE_PATH=./data/orders.db
